// Tawadu — the window: a home surface and a settings surface.
//
// Rust owns all state. The interface reports edits back through the callbacks at
// the bottom of MainWindow; nothing here persists anything by itself.
//
// Two rules this file follows, because both were visibly wrong once:
//  - A Text inside a fixed-height Rectangle must set `height: parent.height`, or
//    its `vertical-alignment` centres within the text and the glyphs sit high.
//  - Arabic and Latin never share one `text:` string. The bidi algorithm then
//    reorders the runs and the words come out of line. Each run gets its own Text.

import { AthkarItemView, CalendarDay, CityResult, CityRow, ContextChip, CreditPack, CreditRow, DayTime, EventVoiceRow, MethodRow, MosqueProfile, OptionRow, PackRow, Row, RuleOption, VoiceOption } from "types.slint";

// Design tokens — Plaster theme. Declared here (not in an imported file) so the
// Rust side can reach the global and switch themes at runtime.
export global Palette {
    in property <color> bg: #F6F1E8;
    in property <color> surface: #FFFDF8;
    in property <color> surface-secondary: #EFE8DB;
    in property <color> ink: #211C15;
    in property <color> ink-muted: #6E665A;
    in property <color> border: #E2D9C9;
    in property <color> accent: #2E5C4E;
    in property <color> accent-soft: #E3EEE9;
    in property <color> accent-ink: #FFFFFF;
    in property <color> gold: #B08A4A;
    // Phase 5: inline validation errors (Prism token review flagged in PR).
    in property <color> danger: #9C3B2E;
    // Ramadan defines no distinct gold — its accent IS gold (Prism §4).
    in property <bool> gold-is-accent: false;
    in property <length> radius: 16px;
    in property <length> radius-small: 10px;
}

// A card with a small caps heading. The Arabic eyebrow (when present) is
// its own run at the same size, never letterspaced (Prism §6 rule 4).
component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> title-ar: "";
    padding: 12px;
    spacing: 6px;
    Text {
        text: title;
        font-size: 11px;
        letter-spacing: 1px;
        color: Palette.ink-muted;
    }
    if (title-ar != "") : Text {
        text: title-ar;
        font-size: 11px;
        color: Palette.ink-muted;
        horizontal-alignment: right;
    }
}

// A labelled row of mutually exclusive pills.
component Segmented inherits HorizontalLayout {
    in property <string> label;
    in property <[OptionRow]> options;
    in property <string> selected;
    callback picked(string);
    spacing: 8px;
    Text {
        text: label;
        font-size: 12px;
        color: Palette.ink-muted;
        width: 92px;
        vertical-alignment: center;
    }
    for option in options : Rectangle {
        height: 30px;
        width: pill.preferred-width + 22px;
        background: selected == option.value ? Palette.accent-soft : Palette.surface;
        border-color: selected == option.value ? Palette.accent : Palette.border;
        border-width: 1px;
        border-radius: Palette.radius-small;
        pill := Text {
            text: option.label;
            font-size: 12px;
            color: selected == option.value ? Palette.accent : Palette.ink;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => { picked(option.value); }
        }
    }
}

// A labelled on/off row.
component Toggle inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled(bool);
    height: 32px;
    background: Palette.surface-secondary;
    border-radius: Palette.radius-small;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        Text {
            text: label;
            font-size: 13px;
            color: Palette.ink;
            height: 20px;
            vertical-alignment: center;
        }
        Rectangle { }
        Rectangle {
            width: 36px;
            height: 20px;
            background: on ? Palette.accent : Palette.border;
            border-radius: 10px;
            Rectangle {
                x: on ? 18px : 2px;
                y: 2px;
                width: 16px;
                height: 16px;
                background: Palette.accent-ink;
                border-radius: 8px;
            }
        }
    }
    TouchArea {
        clicked => { toggled(!on); }
    }
}

// A labelled − value + stepper. `step`/`min-value`/`max-value` extend the
// original (defaults keep the iqamah steppers' behaviour unchanged); the
// trim stepper uses step 5, range 0–300 and a zero label (Prism §7).
component Stepper inherits HorizontalLayout {
    in property <string> label;
    in property <string> label-ar: "";
    in property <int> value;
    in property <int> step: 1;
    in property <int> min-value: 0;
    in property <int> max-value: 1000000;
    in property <string> zero-label: "";
    in property <string> zero-label-ar: "";
    callback changed(int);
    spacing: 8px;
    Text {
        text: label;
        font-size: 13px;
        color: Palette.ink;
        width: 84px;
        vertical-alignment: center;
    }
    if (label-ar != "") : Text {
        text: label-ar;
        font-size: 13px;
        color: Palette.ink-muted;
        vertical-alignment: center;
    }
    Rectangle {
        width: 28px;
        height: 28px;
        background: Palette.surface;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: Palette.radius-small;
        Text {
            text: "−";
            font-size: 16px;
            color: Palette.ink;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => { changed(Math.max(min-value, value - step)); }
        }
    }
    if (value == 0 && zero-label != "") : Text {
        text: zero-label;
        font-size: 13px;
        font-weight: 600;
        color: Palette.ink;
        width: 64px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if (!(value == 0 && zero-label != "")) : Text {
        text: value;
        font-size: 15px;
        font-weight: 600;
        color: Palette.ink;
        width: 46px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if (value == 0 && zero-label-ar != "") : Text {
        text: zero-label-ar;
        font-size: 13px;
        color: Palette.ink-muted;
        vertical-alignment: center;
    }
    Rectangle {
        width: 28px;
        height: 28px;
        background: Palette.surface;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: Palette.radius-small;
        Text {
            text: "+";
            font-size: 16px;
            color: Palette.ink;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => { changed(Math.min(max-value, value + step)); }
        }
    }
}

// A button.
component Action inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback triggered();
    opacity: enabled ? 1.0 : 0.45;
    height: 36px;
    width: label-text.preferred-width + 34px;
    background: primary ? Palette.accent : Palette.surface;
    border-color: primary ? Palette.accent : Palette.border;
    border-width: 1px;
    border-radius: Palette.radius-small;
    label-text := Text {
        text: label;
        font-size: 14px;
        font-weight: 600;
        color: primary ? Palette.accent-ink : Palette.ink;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { if (enabled) { triggered(); } }
    }
}

// A run of text inside a layout row: the layout stretches it, so centring the
// glyphs is enough. (Inside a fixed-height Rectangle, set `height: parent.height`
// on the Text itself — that is what Segmented, Stepper and Action do.)
component RowText inherits Text {
    vertical-alignment: center;
}

// ---- audio components (Phase 3, Prism's proposal) ----

// A small pill chip. tone "gold" is reserved for the athkar marker.
component Badge inherits Rectangle {
    in property <string> label;
    in property <string> tone: "neutral";
    height: 20px;
    width: badge-text.preferred-width + 14px;
    background: Palette.surface-secondary;
    border-radius: 10px;
    badge-text := Text {
        text: label;
        font-size: 11px;
        color: tone == "gold" ? (Palette.gold-is-accent ? Palette.accent : Palette.gold) : Palette.ink-muted;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One installed voice pack. Bundled packs show no Remove button (they are
// the offline floor); removal is a two-step inline confirm, never a modal.
component PackCard inherits Rectangle {
    in property <PackRow> pack;
    in property <bool> previewing;
    in-out property <bool> confirming-remove;
    callback preview(string);
    callback remove(string);
    callback show-attribution(string);
    width: 210px;
    height: 176px;
    background: pack.is-selected ? Palette.accent-soft : Palette.surface;
    border-color: pack.is-selected ? Palette.accent : Palette.border;
    border-width: 1px;
    border-radius: Palette.radius-small;
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        Text {
            text: pack.name;
            font-size: 15px;
            font-weight: 600;
            color: Palette.ink;
            overflow: elide;
        }
        if (pack.name-ar != "") : Text {
            text: pack.name-ar;
            font-size: 13px;
            color: Palette.ink-muted;
            horizontal-alignment: right;
            overflow: elide;
        }
        Text {
            text: pack.reciter;
            font-size: 12px;
            color: Palette.ink-muted;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 6px;
            // The licence badge opens the credits view — a licence
            // obligation reachable in two clicks (Prism §3).
            Badge {
                label: pack.license;
                TouchArea { clicked => { show-attribution(pack.id); } }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            RowText { text: "Duration"; font-size: 11px; color: Palette.ink-muted; }
            RowText { text: "المدة"; font-size: 11px; color: Palette.ink-muted; }
            if (pack.duration != "") : RowText {
                text: pack.duration;
                font-size: 12px;
                font-weight: 600;
                color: Palette.ink;
            }
            if (pack.duration == "") : RowText { text: "Not available"; font-size: 11px; color: Palette.ink-muted; }
            if (pack.duration == "") : RowText { text: "غير متاح"; font-size: 11px; color: Palette.ink-muted; }
        }
        Rectangle { }
        HorizontalLayout {
            spacing: 6px;
            Action {
                label: previewing ? "Stop" : "Preview";
                primary: previewing;
                triggered => { preview(pack.id); }
            }
            if (!pack.is-bundled && !confirming-remove) : Action {
                label: "Remove";
                primary: false;
                triggered => { confirming-remove = true; }
            }
            if (!pack.is-bundled && confirming-remove) : HorizontalLayout {
                spacing: 4px;
                Action {
                    label: "Remove";
                    primary: true;
                    triggered => { remove(pack.id); confirming-remove = false; }
                }
                Action {
                    label: "Cancel";
                    primary: false;
                    triggered => { confirming-remove = false; }
                }
            }
        }
    }
}

// One event's voice row: pill + mode chip, inline-expanding voice list
// (in flow, banner pattern — never an overlay inside the Flickable).
component VoiceRow inherits Rectangle {
    in property <EventVoiceRow> event;
    in property <bool> expanded;
    in property <[VoiceOption]> voices;
    callback toggle-expanded(string);
    callback pick-voice(string, string);
    callback set-mode(string, string);
    callback reset-mode(string);
    background: Palette.surface-secondary;
    border-radius: Palette.radius-small;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            // Gold's one job in the audio band: the athkar marker.
            if (event.kind == "athkar") : Rectangle {
                width: 8px;
                height: 8px;
                y: 9px;
                border-radius: 4px;
                background: Palette.gold-is-accent ? Palette.accent : Palette.gold;
            }
            RowText {
                text: event.label;
                font-size: 13px;
                font-weight: 600;
                color: Palette.ink;
            }
            RowText {
                text: event.label-ar;
                font-size: 13px;
                color: event.kind == "athkar" ? (Palette.gold-is-accent ? Palette.accent : Palette.gold) : Palette.ink-muted;
            }
            Rectangle { }
            Rectangle {
                height: 26px;
                width: Math.min(180px, voice-pill.preferred-width + 18px);
                background: Palette.surface;
                border-color: Palette.border;
                border-width: 1px;
                border-radius: 13px;
                voice-pill := Text {
                    text: event.has-voice ? event.voice-label : "Not set";
                    font-size: 12px;
                    color: Palette.ink;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TouchArea { clicked => { toggle-expanded(event.kind); } }
            }
            Rectangle {
                height: 26px;
                width: mode-chip.preferred-width + 18px;
                background: Palette.accent-soft;
                border-radius: 13px;
                mode-chip := Text {
                    text: event.mode == "shuffle" ? "Shuffle" : "Sequential";
                    font-size: 12px;
                    color: Palette.accent;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { set-mode(event.kind, event.mode == "shuffle" ? "sequential" : "shuffle"); }
                }
            }
        }
        if (expanded) : VerticalLayout {
            spacing: 4px;
            if (!event.has-voice) : VerticalLayout {
                spacing: 2px;
                Text { text: "No voice selected"; font-size: 12px; font-weight: 600; color: Palette.ink; }
                Text { text: "لم يُحدد صوت"; font-size: 12px; color: Palette.ink-muted; horizontal-alignment: right; }
                Text { text: "Choose a pack for this event, or leave it on Default."; font-size: 11px; color: Palette.ink-muted; }
                Text { text: "اختر حزمة لهذا الحدث، أو اتركها على الافتراضي."; font-size: 11px; color: Palette.ink-muted; horizontal-alignment: right; }
            }
            for option in voices : Rectangle {
                height: 28px;
                background: event.voice-id == option.id ? Palette.accent-soft : Palette.surface;
                border-color: event.voice-id == option.id ? Palette.accent : Palette.border;
                border-width: 1px;
                border-radius: Palette.radius-small;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    RowText {
                        text: option.label;
                        font-size: 12px;
                        color: event.voice-id == option.id ? Palette.accent : Palette.ink;
                    }
                    RowText {
                        text: option.label-ar;
                        font-size: 12px;
                        color: event.voice-id == option.id ? Palette.accent : Palette.ink-muted;
                    }
                    Rectangle { }
                    RowText {
                        text: option.pack-name;
                        font-size: 11px;
                        color: Palette.ink-muted;
                        overflow: elide;
                    }
                }
                TouchArea { clicked => { pick-voice(event.kind, option.id); } }
            }
            // "Reset to pack default" exists ONLY while an override exists
            // (decision 7); it reuses Quill's audio-voice-default copy.
            if (event.has-override) : Rectangle {
                height: 26px;
                background: Palette.surface;
                border-color: Palette.border;
                border-width: 1px;
                border-radius: Palette.radius-small;
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 6px;
                    RowText { text: "Default"; font-size: 11px; color: Palette.ink; }
                    RowText { text: "الافتراضي"; font-size: 11px; color: Palette.ink-muted; }
                }
                TouchArea { clicked => { reset-mode(event.kind); } }
            }
        }
    }
}

// The master volume slider with a FILLED track (Prism's polish note: the
// fill is the value affordance). Thumb 16 px, track 4 px, drag math in the
// TouchArea; 0–100.
//
// GEOMETRY CONTRACT (D1 fix — do not regress): fill end == knob center ==
// pointer position, for EVERY value. Knob travel is (W − 16px), knob center
// is (W − 16px)·r + 8px; the fill must span exactly that far, and pointer→
// value must map over the same travel (offset 8px), not the full width.
// Slint 1.19's default_geometry pass CENTERS any non-layout element whose
// x/y is unbound and size ≠ 100% (x = (parent − self)/2) — the fill needs
// explicit x: 0px; y: 0px or it anchors to the track center, not the left.
component AudioSlider inherits Rectangle {
    in property <int> value;
    in property <int> min-value: 0;
    in property <int> max-value: 100;
    callback changed(int);
    height: 24px;
    Rectangle {
        y: 10px;
        height: 4px;
        width: parent.width;
        background: Palette.surface-secondary;
        border-radius: 2px;
        Rectangle {
            x: 0px;
            y: 0px;
            height: 4px;
            // Ends exactly at the knob center: (W − 16)·r + 8.
            width: (parent.width - 16px) * (value - min-value) / (max-value - min-value) + 8px;
            background: Palette.accent;
            border-radius: 2px;
        }
    }
    Rectangle {
        x: (parent.width - 16px) * (value - min-value) / (max-value - min-value);
        y: 4px;
        width: 16px;
        height: 16px;
        background: Palette.surface;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 8px;
    }
    TouchArea {
        clicked => {
            changed(Math.max(min-value, Math.min(max-value, min-value + Math.round(((self.mouse-x - 8px) / (parent.width - 16px)) * (max-value - min-value)))));
        }
        moved => {
            if (self.pressed) {
                changed(Math.max(min-value, Math.min(max-value, min-value + Math.round(((self.mouse-x - 8px) / (parent.width - 16px)) * (max-value - min-value)))));
            }
        }
    }
}

// Phase 5 calendar cell (Prism §6.1): dual numbering, today ring, gold
// Ramadan dot, out-of-month muted but numbered (no blank cells).
component DayCell inherits Rectangle {
    in property <CalendarDay> day;
    in property <string> primary;
    callback picked(string);
    height: 52px;
    background: day.is-today ? Palette.accent-soft : Palette.surface;
    border-color: day.is-today ? Palette.accent : Palette.border;
    border-width: day.is-today ? 2px : 1px;
    border-radius: Palette.radius-small;
    opacity: day.in-month ? 1.0 : 0.5;
    VerticalLayout {
        padding: 4px;
        spacing: 0px;
        alignment: center;
        Text {
            text: primary == "hijri" ? (day.hijri == 0 ? "—" : "\{day.hijri}") : "\{day.gregorian}";
            font-size: 15px;
            font-weight: 600;
            color: Palette.ink;
            horizontal-alignment: center;
        }
        Text {
            text: primary == "hijri" ? "\{day.gregorian}" : (day.hijri == 0 ? "—" : "\{day.hijri}");
            font-size: 11px;
            color: Palette.ink-muted;
            horizontal-alignment: center;
        }
    }
    if (day.is-ramadan) : Rectangle {
        x: parent.width - 10px;
        y: 4px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Palette.gold;
    }
    TouchArea { clicked => { picked(day.iso); } }
}

export component MainWindow inherits Window {
    title: "Tawadu";
    width: 980px;
    height: 620px;
    background: Palette.bg;

    // ---- navigation ----
    in-out property <string> page: "home";

    // ---- home ----
    in property <string> location_name;
    in property <string> location_name_ar;
    in property <string> hijri_date;
    in property <string> next_name;
    in property <string> next_name_ar;
    in property <string> countdown;
    in property <string> next_iqamah;
    in property <string> next_iqamah_caption;
    in property <string> next_iqamah_caption_ar;
    // ---- Phase 5 mosques (Prism §4, Quill §4.2) ----
    in property <[MosqueProfile]> mosques;
    in-out property <string> editing_mosque;
    in property <string> mosque_remove_confirm;
    in property <bool> mosque_name_hint;
    in property <string> mosque_remove_body;
    in property <bool> mosque_remove_active;
    in property <string> athkar_text;
    in property <string> athkar_label;
    in property <string> athkar_progress;
    in property <bool> athkar_auto;
    in property <string> athkar_context_key;
    in property <[AthkarItemView]> athkar_items;
    in property <[ContextChip]> athkar_contexts;
    in property <[Row]> rows;

    // ---- settings ----
    in property <string> settings_location_name;
    in property <string> settings_location_name_ar;
    in-out property <string> location_query;
    in property <[CityRow]> city_results;
    // ---- Phase 5 city picker (Prism §3/§8, Quill §4.1 verbatim) ----
    in-out property <string> city_query;
    in property <[CityResult]> picker_results;
    in property <[CityResult]> recent_cities;
    in-out property <int> highlighted_result;
    in property <string> picker_message;
    in property <string> picker_message_body;
    in property <string> city_disambiguation;
    in property <bool> city_cap_visible;
    in property <bool> gps_available;
    in property <bool> gps_busy;
    in property <bool> gps_confirm_visible;
    in property <string> gps_lat;
    in property <string> gps_lon;
    in property <bool> picker_db_available;
    in-out property <bool> coords_open;
    in-out property <string> manual_lat;
    in-out property <string> manual_lon;
    in-out property <string> manual_name;
    in-out property <string> manual_tz;
    in-out property <string> manual_tz_query;
    in property <[OptionRow]> tz_results;
    in property <string> manual_error;
    in property <string> settings_location_tz;
    // ---- Phase 5 high-latitude honesty (Prism §5, Quill §4.3) ----
    in property <[RuleOption]> high_lat_rules;
    in property <string> selected_high_lat_rule;
    in property <bool> explain_visible;
    in property <string> explain_title;
    in property <string> explain_body;
    in property <bool> next_none_visible;
    in-out property <bool> how_computed_open;
    in property <string> computed_summary;
    in property <string> variance_line;
    in property <string> fine_tune_summary;
    in property <[int]> fine_tune;
    in-out property <bool> fine_tune_open;
    // ---- Phase 5 calendar + Ramadan (Prism §6, Quill §4.4) ----
    in property <string> calendar_month_label;
    in property <string> calendar_month_label_ar;
    in property <[CalendarDay]> calendar_days;
    in property <string> calendar_primary;
    in property <bool> ramadan_month;
    in property <bool> ramadan_mode;
    in property <int> ramadan_banner;
    in property <string> hijri_range_note;
    in property <bool> calendar_prev_enabled;
    in property <bool> calendar_next_enabled;
    in property <string> selected_day_label;
    in property <[DayTime]> selected_day_times;
    in property <[MethodRow]> methods_left;
    in property <[MethodRow]> methods_right;
    in property <string> selected_method;
    in property <[OptionRow]> madhab_options;
    in property <string> selected_madhab;
    in property <[OptionRow]> high_latitude_options;
    in property <string> selected_high_latitude;
    in property <[OptionRow]> rounding_options;
    in property <string> selected_rounding;
    in property <[OptionRow]> theme_options;
    in property <string> selected_theme;
    in property <[OptionRow]> language_options;
    in property <string> selected_language;
    in property <int> pre_alert_minutes;
    in property <int> iqamah_fajr;
    in property <int> iqamah_dhuhr;
    in property <int> iqamah_asr;
    in property <int> iqamah_maghrib;
    in property <int> iqamah_isha;
    in property <string> status_message;

    // ---- notifications ----
    in property <bool> notif_pre_alert;
    in property <bool> start_at_login;
    in property <bool> notif_athan;
    in property <bool> notif_iqamah;
    in property <bool> notif_athkar;
    in property <bool> notif_system;
    in property <bool> quiet_hours_enabled;
    in property <string> quiet_from;
    in property <string> quiet_to;

    // ---- in-app notification ----
    in property <string> banner_title;
    in property <string> banner_body;
    in property <bool> banner_visible;

    // ---- audio (Phase 3) ----
    in property <[PackRow]> audio_packs;
    in property <[VoiceOption]> audio_voices;
    in property <[VoiceOption]> chime_voices;
    in property <[EventVoiceRow]> event_voices;
    in property <string> previewing_pack_id;
    in property <string> expanded_event;
    in property <int> audio_volume;
    in property <int> athan_stop_after_s;
    in property <string> trim_unit;
    in property <string> trim_unit_ar;
    in property <string> audio_message;
    in property <string> audio_message_ar;
    in property <string> audio_message_arg;
    in property <string> audio_message_ar_after;

    // ---- credits / attribution ----
    in property <[CreditPack]> credit_packs;
    in property <[CreditRow]> credit_fonts;
    in property <[CreditRow]> credit_libs;
    in property <string> code_license;

    // ---- callbacks ----
    callback open-settings();
    callback close-settings();
    callback search-city(string);
    callback select-city(string);
    callback open-city-picker();
    callback picker-back();
    callback search-cities(string);
    callback pick-city(string);
    callback pick-recent(string);
    callback nav-result(int);
    callback use-gps();
    callback gps-confirm();
    callback gps-cancel();
    callback apply-coords(string, string, string, string);
    callback search-tz(string);
    callback pick-tz(string);
    callback add-mosque();
    callback activate-mosque(string);
    callback set-mosque-name(string, string);
    callback set-mosque-name-ar(string, string);
    callback set-mosque-offset(string, string, int);
    callback remove-mosque(string);
    callback edit-mosque(string);
    callback cancel-mosque-remove();
    callback done-editing();
    callback set-high-lat(string);
    callback set-fine-tune(string, int);
    callback show-explain();
    callback explain-change-rule();
    callback explain-why-rules();
    callback open-calendar();
    callback calendar-back();
    callback calendar-nav(int);
    callback calendar-today();
    callback set-calendar-primary(string);
    callback pick-day(string);
    callback set-ramadan-mode(bool);
    callback set-method(string);
    callback set-madhab(string);
    callback set-high-latitude(string);
    callback set-rounding(string);
    callback set-theme(string);
    callback set-language(string);
    callback set-pre-alert(int);
    callback set-iqamah(string, int);
    callback set-notif-kind(string, bool);
    callback set-quiet-enabled(bool);
    callback set-start-at-login(bool);
    callback set-quiet-from(string);
    callback set-quiet-to(string);
    callback save-settings();
    callback import-pack-file();
    callback import-pack-folder();
    callback preview-pack(string);
    callback remove-pack(string);
    callback show-attribution(string);
    callback pick-event-voice(string, string);
    callback set-event-mode(string, string);
    callback reset-event-mode(string);
    callback toggle-event-expanded(string);
    callback set-audio-volume(int);
    callback set-athan-trim(int);
    callback dismiss-audio-message();
    callback close-credits();
    callback open-athkar();
    callback close-athkar();
    callback athkar-switch-context(string);
    callback athkar-follow-window();
    callback athkar-repeat(int, int);
    callback athkar-reset();

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        // In-app notification banner, in flow: it pushes the header and page
        // down instead of overlapping them. The `if` removes it entirely when
        // hidden, so it occupies zero space (including its layout spacing).
        // The explicit height keeps it compact; the width follows the layout.
        if (banner_visible) : Rectangle {
            height: 76px;
            background: Palette.surface;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: Palette.radius;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                Text {
                    text: banner_title;
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.ink;
                }
                Text {
                    text: banner_body;
                    font-size: 12px;
                    color: Palette.ink-muted;
                }
            }
        }

        // ---- header ----
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                Text {
                    text: "Tawadu · تواضع";
                    font-size: 22px;
                    font-weight: 600;
                    color: Palette.ink;
                }
                HorizontalLayout {
                    spacing: 6px;
                    RowText {
                        text: location_name;
                        font-size: 13px;
                        color: Palette.ink-muted;
                    }
                    RowText {
                        text: location_name_ar;
                        font-size: 13px;
                        color: Palette.ink-muted;
                    }
                    RowText {
                        // RLM (U+200F) forces an RTL base direction so the
                        // mixed digit/Arabic date reads [هـ][1448][month][9].
                        // Slint 1.19 Text has no direction property; the
                        // shared-parley layout honours the RLM mark. Keep the
                        // empty case truly empty.
                        text: hijri_date == "" ? "" : "\u{200F}" + hijri_date;
                        font-size: 13px;
                        color: Palette.ink-muted;
                    }
                }
            }
            Rectangle { }
            Action {
                label: "Calendar";
                primary: false;
                triggered => { open-calendar(); }
            }
            Action {
                label: "الإعدادات";
                primary: false;
                triggered => { open-settings(); }
            }
        }

        // ---- home ----
        if (page == "home") : HorizontalLayout {
            spacing: 24px;

            VerticalLayout {
                spacing: 16px;
                width: 420px;

                Rectangle {
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 4px;
                        Text {
                            text: "NEXT PRAYER";
                            font-size: 11px;
                            letter-spacing: 1px;
                            color: Palette.accent;
                        }
                        Text {
                            text: next_name;
                            font-size: 26px;
                            font-weight: 600;
                            color: Palette.ink;
                        }
                        Text {
                            text: next_name_ar;
                            font-size: 20px;
                            color: Palette.accent;
                        }
                        Text {
                            text: countdown;
                            font-size: 54px;
                            font-weight: 400;
                            color: Palette.ink;
                        }
                    }
                }

                Rectangle {
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius-small;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 2px;
                        Text {
                            text: "NEXT IQAMAH";
                            font-size: 11px;
                            letter-spacing: 1px;
                            color: Palette.ink-muted;
                        }
                        Text {
                            text: next_iqamah;
                            font-size: 16px;
                            font-weight: 600;
                            color: Palette.ink;
                        }
                        if (next_iqamah_caption != "") : Text {
                            text: next_iqamah_caption;
                            font-size: 11px;
                            color: Palette.ink-muted;
                        }
                        if (next_iqamah_caption_ar != "") : Text {
                            text: next_iqamah_caption_ar;
                            font-size: 11px;
                            color: Palette.ink-muted;
                            horizontal-alignment: end;
                        }
                    }
                }

                Rectangle {
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius;
                    // Phase 4: tap-through to the real athkar view.
                    TouchArea {
                        clicked => { open-athkar(); }
                    }
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: athkar_label;
                                font-size: 11px;
                                letter-spacing: 1px;
                                color: Palette.ink-muted;
                            }
                            Text {
                                text: athkar_progress;
                                font-size: 11px;
                                color: Palette.accent;
                                horizontal-alignment: end;
                            }
                        }
                        Text {
                            text: athkar_text;
                            font-size: 18px;
                            color: Palette.ink;
                            horizontal-alignment: end;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Rectangle {
                background: Palette.surface-secondary;
                border-radius: Palette.radius;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: "Today";
                        font-size: 11px;
                        letter-spacing: 1px;
                        color: Palette.ink-muted;
                    }
                    for row in rows : Rectangle {
                        background: row.is_next ? Palette.accent-soft : Palette.surface;
                        border-color: row.is_next ? Palette.accent : Palette.border;
                        border-width: 1px;
                        border-radius: Palette.radius-small;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            RowText {
                                text: row.name;
                                font-size: 15px;
                                font-weight: row.is_prayer ? 600 : 400;
                                color: row.is_prayer ? Palette.ink : Palette.ink-muted;
                            }
                            Rectangle { }
                            if (row.is_none || row.estimated) : Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Palette.ink-muted;
                            }
                            VerticalLayout {
                                spacing: 0px;
                                alignment: center;
                                RowText {
                                    text: row.time;
                                    font-size: 15px;
                                    font-weight: 500;
                                    color: row.is_none ? Palette.ink-muted : Palette.ink;
                                }
                                if (row.estimated) : Text {
                                    text: "Estimated";
                                    font-size: 10px;
                                    color: Palette.ink-muted;
                                    horizontal-alignment: end;
                                }
                                if (row.is_none) : Text {
                                    text: "No defined time";
                                    font-size: 10px;
                                    color: Palette.ink-muted;
                                    horizontal-alignment: end;
                                }
                            }
                        }
                        if (row.is_none || row.estimated) : TouchArea {
                            clicked => { show-explain(); }
                        }
                    }
                    if (explain_visible) : Rectangle {
                        background: Palette.surface-secondary;
                        border-radius: Palette.radius-small;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text { text: explain_title; font-size: 14px; font-weight: 600; color: Palette.ink; wrap: word-wrap; }
                            Text { text: explain_body; font-size: 12px; color: Palette.ink; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                Action { label: "Change rule"; primary: false; triggered => { explain-change-rule(); } }
                                Action { label: "Why these rules?"; primary: false; triggered => { explain-why-rules(); } }
                            }
                        }
                    }
                    Action {
                        label: how_computed_open ? "Hide computation details" : "How these times are computed";
                        primary: false;
                        triggered => { how_computed_open = !how_computed_open; }
                    }
                    if (how_computed_open) : VerticalLayout {
                        spacing: 4px;
                        Text { text: computed_summary; font-size: 12px; color: Palette.ink-muted; wrap: word-wrap; }
                        Text {
                            text: variance_line;
                            font-size: 11px;
                            color: Palette.ink-muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ---- settings ----
        // The settings page outgrew the window once notifications were added, so it
        // scrolls rather than clipping the lower cards.
        if (page == "settings") : Flickable {
            VerticalLayout {
            settings-columns := HorizontalLayout {
            spacing: 20px;

            // left column
            VerticalLayout {
                spacing: 14px;
                width: 460px;
                // Without this the cards stretch to fill whatever height the
                // taller right column imposes, which pushes the ALERTS steppers
                // out of view. `start` keeps each card at its own height.
                alignment: start;

                Rectangle {
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius;
                    Section { title: "LOCATION";
                        HorizontalLayout {
                            spacing: 6px;
                            RowText {
                                text: settings_location_name;
                                font-size: 16px;
                                font-weight: 600;
                                color: Palette.accent;
                            }
                            RowText {
                                text: settings_location_name_ar;
                                font-size: 16px;
                                font-weight: 600;
                                color: Palette.accent;
                            }
                        }
                        RowText {
                            text: settings_location_tz;
                            font-size: 12px;
                            color: Palette.ink-muted;
                        }
                        Action {
                            label: "City picker";
                            primary: false;
                            triggered => { open-city-picker(); }
                        }
                    }
                }

                Rectangle {
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius;
                    Section { title: "MOSQUES"; title-ar: "المساجد";
                        if (mosques.length == 0) : VerticalLayout {
                            spacing: 6px;
                            Text { text: "No mosque profiles yet"; font-size: 14px; font-weight: 600; color: Palette.ink; }
                            Text { text: "Add your mosque to get iqamah times."; font-size: 12px; color: Palette.ink-muted; }
                        }
                        for m in mosques : Rectangle {
                            background: m.is-active ? Palette.accent-soft : Palette.surface;
                            border-color: m.is-active ? Palette.accent : Palette.border;
                            border-width: 1px;
                            border-radius: Palette.radius-small;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: m.name; font-size: 14px; font-weight: 600; color: Palette.ink; }
                                    if (m.name-ar != "") : Text {
                                        text: m.name-ar;
                                        font-size: 13px;
                                        color: Palette.ink-muted;
                                        horizontal-alignment: end;
                                    }
                                    if (m.is-active) : Rectangle {
                                        height: 20px;
                                        width: active-badge.preferred-width + 12px;
                                        border-radius: 10px;
                                        background: Palette.accent;
                                        active-badge := Text { text: "Active"; font-size: 10px; color: Palette.accent-ink; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text {
                                    text: m.offsets-summary == "" ? "No offsets set" : m.offsets-summary;
                                    font-size: 11px;
                                    color: Palette.ink-muted;
                                }
                                if (editing_mosque != m.id && mosque_remove_confirm != m.id) : HorizontalLayout {
                                    spacing: 8px;
                                    Action { label: "Edit"; primary: false; triggered => { edit-mosque(m.id); } }
                                    Action { label: "Remove"; primary: false; triggered => { remove-mosque(m.id); } }
                                }
                                if (mosque_remove_confirm == m.id) : VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Remove this mosque?"; font-size: 13px; font-weight: 600; color: Palette.ink; }
                                    Text { text: mosque_remove_body; font-size: 12px; color: Palette.ink; wrap: word-wrap; }
                                    if (mosque_remove_active) : Text {
                                        text: "This is the active mosque.";
                                        font-size: 11px;
                                        color: Palette.ink-muted;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Action { label: "Remove"; primary: true; triggered => { remove-mosque(m.id); } }
                                        Action { label: "Cancel"; primary: false; triggered => { cancel-mosque-remove(); } }
                                    }
                                }
                                if (editing_mosque == m.id) : VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Mosque name"; font-size: 12px; color: Palette.ink-muted; }
                                    TextInput {
                                        width: 240px;
                                        height: 30px;
                                        text: m.name;
                                        font-size: 13px;
                                        color: Palette.ink;
                                        edited => { set-mosque-name(m.id, self.text); }
                                    }
                                    if (m.name == "") : Text {
                                        text: "Enter a name to save.";
                                        font-size: 11px;
                                        color: Palette.danger;
                                    }
                                    Text { text: "Arabic name (optional)"; font-size: 12px; color: Palette.ink-muted; }
                                    TextInput {
                                        width: 240px;
                                        height: 30px;
                                        text: m.name-ar;
                                        font-size: 13px;
                                        color: Palette.ink;
                                        edited => { set-mosque-name-ar(m.id, self.text); }
                                    }
                                    Text { text: "Iqamah offsets (minutes after the athan)"; font-size: 12px; color: Palette.ink-muted; wrap: word-wrap; }
                                    Stepper { label: "Fajr"; label-ar: "الفجر"; value: m.fajr; step: 1; min-value: 0; max-value: 60; changed(v) => { set-mosque-offset(m.id, "fajr", v); } }
                                    Stepper { label: "Dhuhr"; label-ar: "الظهر"; value: m.dhuhr; step: 1; min-value: 0; max-value: 60; changed(v) => { set-mosque-offset(m.id, "dhuhr", v); } }
                                    Stepper { label: "Asr"; label-ar: "العصر"; value: m.asr; step: 1; min-value: 0; max-value: 60; changed(v) => { set-mosque-offset(m.id, "asr", v); } }
                                    Stepper { label: "Maghrib"; label-ar: "المغرب"; value: m.maghrib; step: 1; min-value: 0; max-value: 60; changed(v) => { set-mosque-offset(m.id, "maghrib", v); } }
                                    Stepper { label: "Isha"; label-ar: "العشاء"; value: m.isha; step: 1; min-value: 0; max-value: 60; changed(v) => { set-mosque-offset(m.id, "isha", v); } }
                                    Action { label: "Done"; primary: true; triggered => { done-editing(); } }
                                }
                            }
                            TouchArea {
                                clicked => {
                                    if (!m.is-active && editing_mosque != m.id) {
                                        activate-mosque(m.id);
                                    }
                                }
                            }
                        }
                        Action { label: "+ Add mosque"; primary: mosques.length == 0; triggered => { add-mosque(); } }
                    }
                }

                Rectangle {
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius;
                    Section { title: "ALERTS";
                        Stepper {
                            label: "Pre-alert";
                            value: pre_alert_minutes;
                            changed(next) => { set-pre-alert(next); }
                        }
                        Stepper {
                            label: "Fajr";
                            value: iqamah_fajr;
                            changed(next) => { set-iqamah("fajr", next); }
                        }
                        Stepper {
                            label: "Dhuhr";
                            value: iqamah_dhuhr;
                            changed(next) => { set-iqamah("dhuhr", next); }
                        }
                        Stepper {
                            label: "Asr";
                            value: iqamah_asr;
                            changed(next) => { set-iqamah("asr", next); }
                        }
                        Stepper {
                            label: "Maghrib";
                            value: iqamah_maghrib;
                            changed(next) => { set-iqamah("maghrib", next); }
                        }
                        Stepper {
                            label: "Isha";
                            value: iqamah_isha;
                            changed(next) => { set-iqamah("isha", next); }
                        }
                    }
                }
            }

            // right column
            VerticalLayout {
                spacing: 14px;
                width: 420px;
                alignment: start;

                Rectangle {
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius;
                    Section { title: "CALCULATION";
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 2px;
                                for method in methods_left : Rectangle {
                                    height: 24px;
                                    background: selected_method == method.key ? Palette.accent-soft : Palette.surface-secondary;
                                    border-radius: Palette.radius-small;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 6px;
                                        RowText {
                                            text: method.label;
                                            font-size: 12px;
                                            color: selected_method == method.key ? Palette.accent : Palette.ink;
                                        }
                                        RowText {
                                            text: method.label_ar;
                                            font-size: 12px;
                                            color: selected_method == method.key ? Palette.accent : Palette.ink-muted;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { set-method(method.key); }
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                for method in methods_right : Rectangle {
                                    height: 24px;
                                    background: selected_method == method.key ? Palette.accent-soft : Palette.surface-secondary;
                                    border-radius: Palette.radius-small;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 6px;
                                        RowText {
                                            text: method.label;
                                            font-size: 12px;
                                            color: selected_method == method.key ? Palette.accent : Palette.ink;
                                        }
                                        RowText {
                                            text: method.label_ar;
                                            font-size: 12px;
                                            color: selected_method == method.key ? Palette.accent : Palette.ink-muted;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { set-method(method.key); }
                                    }
                                }
                            }
                        }
                        Segmented {
                            label: "Madhab";
                            options: madhab_options;
                            selected: selected_madhab;
                            picked(value) => { set-madhab(value); }
                        }
                        Text { text: "High-latitude rule"; font-size: 13px; font-weight: 600; color: Palette.ink; }
                        for rule in high_lat_rules : Rectangle {
                            background: rule.key == selected_high_lat_rule ? Palette.accent-soft : Palette.surface;
                            border-color: rule.key == selected_high_lat_rule ? Palette.accent : Palette.border;
                            border-width: 1px;
                            border-radius: Palette.radius-small;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: rule.label; font-size: 13px; font-weight: 600; color: Palette.ink; }
                                    Text { text: rule.label-ar; font-size: 12px; color: Palette.ink-muted; horizontal-alignment: end; }
                                }
                                Text { text: rule.desc; font-size: 11px; color: Palette.ink-muted; wrap: word-wrap; }
                            }
                            TouchArea { clicked => { set-high-lat(rule.key); } }
                        }
                        Text {
                            text: "These rules change Fajr and Isha only, and only near the polar circles. They never create a sunrise or sunset.";
                            font-size: 11px;
                            color: Palette.ink-muted;
                            wrap: word-wrap;
                        }
                        Segmented {
                            label: "Rounding";
                            options: rounding_options;
                            selected: selected_rounding;
                            picked(value) => { set-rounding(value); }
                        }
                        Action {
                            label: fine_tune_open ? "Hide fine-tune" : (fine_tune_summary == "" ? "Fine-tune times" : "Fine-tune times · " + fine_tune_summary);
                            primary: false;
                            triggered => { fine_tune_open = !fine_tune_open; }
                        }
                        if (fine_tune_open) : VerticalLayout {
                            spacing: 4px;
                            Stepper { label: "Fajr"; label-ar: "الفجر"; value: fine_tune[0]; step: 1; min-value: -30; max-value: 30; changed(v) => { set-fine-tune("fajr", v); } }
                            Stepper { label: "Dhuhr"; label-ar: "الظهر"; value: fine_tune[1]; step: 1; min-value: -30; max-value: 30; changed(v) => { set-fine-tune("dhuhr", v); } }
                            Stepper { label: "Asr"; label-ar: "العصر"; value: fine_tune[2]; step: 1; min-value: -30; max-value: 30; changed(v) => { set-fine-tune("asr", v); } }
                            Stepper { label: "Maghrib"; label-ar: "المغرب"; value: fine_tune[3]; step: 1; min-value: -30; max-value: 30; changed(v) => { set-fine-tune("maghrib", v); } }
                            Stepper { label: "Isha"; label-ar: "العشاء"; value: fine_tune[4]; step: 1; min-value: -30; max-value: 30; changed(v) => { set-fine-tune("isha", v); } }
                        }
                    }
                }

                Rectangle {
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius;
                    Section { title: "APPEARANCE";
                        Toggle {
                            label: "Ramadan mode";
                            on: ramadan_mode;
                            toggled(on) => { set-ramadan-mode(on); }
                        }
                        Segmented {
                            label: "Theme";
                            options: theme_options;
                            selected: selected_theme;
                            picked(value) => { set-theme(value); }
                        }
                        Segmented {
                            label: "Language";
                            options: language_options;
                            selected: selected_language;
                            picked(value) => { set-language(value); }
                        }
                        Toggle {
                            label: "Start at login";
                            on: start_at_login;
                            toggled(on) => { set-start-at-login(on); }
                        }
                    }
                }

                Rectangle {
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius;
                    Section { title: "NOTIFICATIONS";
                        Toggle {
                            label: "Pre-alert";
                            on: notif_pre_alert;
                            toggled(on) => { set-notif-kind("pre_alert", on); }
                        }
                        Toggle {
                            label: "Athan";
                            on: notif_athan;
                            toggled(on) => { set-notif-kind("athan", on); }
                        }
                        Toggle {
                            label: "Iqamah";
                            on: notif_iqamah;
                            toggled(on) => { set-notif-kind("iqamah", on); }
                        }
                        Toggle {
                            label: "Athkar";
                            on: notif_athkar;
                            toggled(on) => { set-notif-kind("athkar", on); }
                        }
                        Toggle {
                            label: "System";
                            on: notif_system;
                            toggled(on) => { set-notif-kind("system", on); }
                        }
                        Toggle {
                            label: "Quiet hours";
                            on: quiet_hours_enabled;
                            toggled(on) => { set-quiet-enabled(on); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            TextInput {
                                width: 70px;
                                height: 28px;
                                text: quiet_from;
                                font-size: 13px;
                                color: Palette.ink;
                                edited => { set-quiet-from(self.text); }
                            }
                            TextInput {
                                width: 70px;
                                height: 28px;
                                text: quiet_to;
                                font-size: 13px;
                                color: Palette.ink;
                                edited => { set-quiet-to(self.text); }
                            }
                        }
                    }
                }

            }
            }

            // ---- AUDIO band (Prism's proposal: full-width, below the
            // columns, inside the same Flickable; save row stays last) ----
            Rectangle {
                background: Palette.surface;
                border-color: Palette.border;
                border-width: 1px;
                border-radius: Palette.radius;
                Section { title: "AUDIO"; title-ar: "الصوت";
                    HorizontalLayout {
                        spacing: 6px;
                        RowText { text: "Voice packs"; font-size: 13px; font-weight: 600; color: Palette.ink; }
                        RowText { text: "حزم الأصوات"; font-size: 13px; color: Palette.ink-muted; }
                    }
                    if (audio_packs.length == 0) : Rectangle {
                        height: 130px;
                        background: Palette.surface-secondary;
                        border-radius: Palette.radius-small;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;
                            Text { text: "No voice packs yet"; font-size: 14px; font-weight: 600; color: Palette.ink; }
                            Text { text: "لا توجد حزم صوتية بعد"; font-size: 13px; color: Palette.ink-muted; horizontal-alignment: right; }
                            Text { text: "Add a voice pack to play the adhan and athkar."; font-size: 12px; color: Palette.ink-muted; }
                            Text { text: "أضف حزمة صوتية لتشغيل الأذان والأذكار."; font-size: 12px; color: Palette.ink-muted; horizontal-alignment: right; }
                            Action { label: "Add pack"; primary: true; triggered => { import-pack-folder(); } }
                        }
                    }
                    if (audio_packs.length > 0) : Flickable {
                        height: 190px;
                        content-width: (audio_packs.length + 1) * 220px;
                        HorizontalLayout {
                            spacing: 10px;
                            for pack in audio_packs : PackCard {
                                pack: pack;
                                previewing: previewing_pack_id == pack.id;
                                preview(id) => { preview-pack(id); }
                                remove(id) => { remove-pack(id); }
                                show-attribution(id) => { show-attribution(id); }
                            }
                            Rectangle {
                                width: 210px;
                                height: 176px;
                                background: Palette.surface-secondary;
                                border-color: Palette.border;
                                border-width: 1px;
                                border-radius: Palette.radius-small;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;
                                    alignment: center;
                                    Text { text: "+"; font-size: 24px; color: Palette.ink-muted; horizontal-alignment: center; }
                                    Action { label: "Import from file…"; primary: true; triggered => { import-pack-file(); } }
                                    Action { label: "Add pack"; primary: false; triggered => { import-pack-folder(); } }
                                }
                            }
                        }
                    }
                    if (audio_message != "") : Rectangle {
                        background: Palette.surface-secondary;
                        border-radius: Palette.radius-small;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text { text: audio_message; font-size: 12px; color: Palette.ink; wrap: word-wrap; }
                            // Arabic reading order is RTL: with no layout
                            // direction support in Slint 1.19, the runs are
                            // placed in reverse so before reads rightmost.
                            HorizontalLayout {
                                spacing: 0px;
                                Text { text: audio_message_ar_after; font-size: 12px; color: Palette.ink; }
                                Text { text: audio_message_arg; font-size: 12px; color: Palette.ink; }
                                Text { text: audio_message_ar; font-size: 12px; color: Palette.ink; }
                            }
                        }
                        TouchArea { clicked => { dismiss-audio-message(); } }
                    }
                    HorizontalLayout {
                        spacing: 20px;
                        alignment: start;
                        Rectangle {
                            width: 460px;
                            background: Palette.surface;
                            border-color: Palette.border;
                            border-width: 1px;
                            border-radius: Palette.radius;
                            Section { title: "Voice per event"; title-ar: "الصوت لكل حدث";
                                for row in event_voices : VoiceRow {
                                    event: row;
                                    expanded: expanded_event == row.kind;
                                    voices: row.kind == "chime" ? chime_voices : audio_voices;
                                    toggle-expanded(kind) => { toggle-event-expanded(kind); }
                                    pick-voice(kind, id) => { pick-event-voice(kind, id); }
                                    set-mode(kind, mode) => { set-event-mode(kind, mode); }
                                    reset-mode(kind) => { reset-event-mode(kind); }
                                }
                            }
                        }
                        Rectangle {
                            width: 420px;
                            background: Palette.surface;
                            border-color: Palette.border;
                            border-width: 1px;
                            border-radius: Palette.radius;
                            Section { title: "Playback"; title-ar: "التشغيل";
                                HorizontalLayout {
                                    spacing: 8px;
                                    RowText { text: "Volume"; font-size: 13px; color: Palette.ink; width: 60px; }
                                    RowText { text: "مستوى الصوت"; font-size: 13px; color: Palette.ink-muted; }
                                    AudioSlider {
                                        width: 200px;
                                        value: audio_volume;
                                        changed(v) => { set-audio-volume(v); }
                                    }
                                    RowText { text: audio_volume; font-size: 13px; font-weight: 600; color: Palette.ink; }
                                    RowText { text: "%"; font-size: 13px; color: Palette.ink-muted; }
                                }
                                Stepper {
                                    label: "Stop after";
                                    label-ar: "إيقاف بعد";
                                    value: athan_stop_after_s;
                                    step: 5;
                                    min-value: 0;
                                    max-value: 300;
                                    zero-label: "No trim";
                                    zero-label-ar: "بلا قص";
                                    changed(v) => { set-athan-trim(v); }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    if (trim_unit != "") : RowText { text: trim_unit; font-size: 11px; color: Palette.ink-muted; }
                                    if (trim_unit_ar != "") : RowText { text: trim_unit_ar; font-size: 11px; color: Palette.ink-muted; }
                                }
                            }
                        }
                    }
                }
            }

            Text {
                text: status_message;
                font-size: 12px;
                color: Palette.accent;
            }

            HorizontalLayout {
                spacing: 10px;
                Action {
                    label: "حفظ";
                    primary: true;
                    triggered => { save-settings(); }
                }
                Action {
                    label: "إغلاق";
                    primary: false;
                    triggered => { close-settings(); }
                }
            }
            }
        }

        // ---- Phase 5 calendar (Prism §6, Quill §4.4) ----
        if (page == "calendar") : Flickable {
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Action { label: "Back"; primary: false; triggered => { calendar-back(); } }
                    Text { text: "Calendar"; font-size: 20px; font-weight: 600; color: Palette.ink; vertical-alignment: center; }
                    Text { text: "التقويم"; font-size: 16px; color: Palette.ink-muted; vertical-alignment: center; }
                }
                if (ramadan_banner == 1) : Rectangle {
                    background: Palette.accent-soft;
                    border-color: Palette.gold;
                    border-width: 1px;
                    border-radius: Palette.radius-small;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "Ramadan"; font-size: 14px; font-weight: 600; color: Palette.ink; vertical-alignment: center; }
                        Text { text: "رمضان"; font-size: 14px; color: Palette.ink; vertical-alignment: center; }
                        Rectangle { }
                        Action { label: "Turn on Ramadan mode"; primary: true; triggered => { set-ramadan-mode(true); } }
                    }
                }
                if (ramadan_banner == 2) : Rectangle {
                    background: Palette.surface-secondary;
                    border-radius: Palette.radius-small;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: "Ramadan has ended — turn off mode?"; font-size: 13px; color: Palette.ink; vertical-alignment: center; }
                        Rectangle { }
                        Action { label: "Turn off Ramadan mode"; primary: false; triggered => { set-ramadan-mode(false); } }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Action { label: "‹"; primary: false; enabled: calendar_prev_enabled; triggered => { calendar-nav(-1); } }
                    Text { text: calendar_month_label; font-size: 16px; font-weight: 600; color: Palette.ink; vertical-alignment: center; }
                    Text { text: calendar_month_label_ar; font-size: 14px; color: Palette.ink-muted; vertical-alignment: center; }
                    Action { label: "›"; primary: false; enabled: calendar_next_enabled; triggered => { calendar-nav(1); } }
                    Rectangle { }
                    Action { label: "Today"; primary: false; triggered => { calendar-today(); } }
                }
                if (hijri_range_note != "") : Text {
                    text: hijri_range_note;
                    font-size: 11px;
                    color: Palette.ink-muted;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Primary:"; font-size: 12px; color: Palette.ink-muted; vertical-alignment: center; }
                    Action {
                        label: "Gregorian";
                        primary: calendar_primary == "greg";
                        triggered => { set-calendar-primary("greg"); }
                    }
                    Action {
                        label: "Hijri";
                        primary: calendar_primary == "hijri";
                        triggered => { set-calendar-primary("hijri"); }
                    }
                }
                GridLayout {
                    spacing: 4px;
                    Row {
                        DayCell { day: calendar_days[0]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[1]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[2]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[3]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[4]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[5]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[6]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                    }
                    Row {
                        DayCell { day: calendar_days[7]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[8]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[9]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[10]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[11]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[12]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[13]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                    }
                    Row {
                        DayCell { day: calendar_days[14]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[15]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[16]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[17]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[18]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[19]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[20]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                    }
                    Row {
                        DayCell { day: calendar_days[21]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[22]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[23]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[24]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[25]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[26]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[27]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                    }
                    Row {
                        DayCell { day: calendar_days[28]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[29]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[30]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[31]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[32]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[33]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[34]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                    }
                    Row {
                        DayCell { day: calendar_days[35]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[36]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[37]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[38]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[39]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[40]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                        DayCell { day: calendar_days[41]; primary: calendar_primary; picked(iso) => { pick-day(iso); } }
                    }
                }
                if (selected_day_label != "") : VerticalLayout {
                    spacing: 6px;
                    Text { text: selected_day_label; font-size: 13px; font-weight: 600; color: Palette.ink; }
                    for t in selected_day_times : HorizontalLayout {
                        spacing: 8px;
                        Text { text: t.name; font-size: 13px; color: Palette.ink; width: 90px; }
                        Text { text: t.name-ar; font-size: 12px; color: Palette.ink-muted; }
                        Rectangle { }
                        if (t.estimated) : Text { text: "Estimated"; font-size: 10px; color: Palette.ink-muted; vertical-alignment: center; }
                        Text {
                            text: t.time;
                            font-size: 13px;
                            font-weight: 500;
                            color: t.is-none ? Palette.ink-muted : Palette.ink;
                        }
                    }
                }
            }
        }

        // ---- Phase 5 city picker (Prism §3, Quill §4.1 verbatim) ----
        if (page == "city-picker") : FocusScope {
            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    nav-result(-1);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    nav-result(1);
                    return accept;
                }
                if (event.text == Key.Return) {
                    if (highlighted_result >= 0 && highlighted_result < picker_results.length) {
                        pick-city(picker_results[highlighted_result].id);
                    }
                    return accept;
                }
                if (event.text == Key.Escape) {
                    picker-back();
                    return accept;
                }
                reject
            }
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Action { label: "Back to settings"; primary: false; triggered => { picker-back(); } }
                    Text {
                        text: "City picker";
                        font-size: 20px;
                        font-weight: 600;
                        color: Palette.ink;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "اختيار المدينة";
                        font-size: 16px;
                        color: Palette.ink-muted;
                        vertical-alignment: center;
                        horizontal-alignment: end;
                    }
                }
                Rectangle {
                    height: 36px;
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius-small;
                    TextInput {
                        x: 10px;
                        y: 6px;
                        width: parent.width - 20px;
                        height: 24px;
                        text: city_query;
                        font-size: 14px;
                        color: Palette.ink;
                        edited => { search-cities(self.text); }
                    }
                    if (city_query == "") : Text {
                        x: 10px;
                        y: 8px;
                        text: "Search cities — English or Arabic";
                        font-size: 14px;
                        color: Palette.ink-muted;
                    }
                }
                if (recent_cities.length > 0) : HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Recent"; font-size: 12px; color: Palette.ink-muted; vertical-alignment: center; }
                    for r in recent_cities: Rectangle {
                        height: 28px;
                        width: recent-label.preferred-width + 18px;
                        border-radius: 14px;
                        background: Palette.surface-secondary;
                        recent-label := Text {
                            text: r.name;
                            font-size: 12px;
                            color: Palette.ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { pick-recent(r.id); } }
                    }
                }
                if (city_disambiguation != "") : Text {
                    text: city_disambiguation;
                    font-size: 12px;
                    color: Palette.ink-muted;
                    wrap: word-wrap;
                }
                if (picker_db_available) : Flickable {
                    height: 300px;
                    content-height: picker_results.length * 52px;
                    VerticalLayout {
                        spacing: 0px;
                        for result[i] in picker_results: Rectangle {
                            height: 52px;
                            background: i == highlighted_result ? Palette.surface-secondary : Palette.surface;
                            border-color: Palette.border;
                            border-width: 0.5px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: center;
                                    Text { text: result.name; font-size: 15px; font-weight: 600; color: Palette.ink; }
                                    if (result.name-ar != "") : Text {
                                        text: result.name-ar;
                                        font-size: 13px;
                                        color: Palette.ink-muted;
                                        horizontal-alignment: end;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: center;
                                    Text { text: result.country; font-size: 13px; color: Palette.ink; horizontal-alignment: end; }
                                    Text { text: result.region-line; font-size: 11px; color: Palette.ink-muted; horizontal-alignment: end; }
                                }
                            }
                            TouchArea {
                                clicked => { pick-city(result.id); }
                            }
                        }
                    }
                }
                if (city_cap_visible) : Text {
                    text: "Showing the first 50 — keep typing to narrow the search.";
                    font-size: 12px;
                    color: Palette.ink-muted;
                }
                if (picker_message != "") : VerticalLayout {
                    spacing: 4px;
                    Text { text: picker_message; font-size: 14px; font-weight: 600; color: Palette.ink; wrap: word-wrap; }
                    if (picker_message_body != "") : Text {
                        text: picker_message_body;
                        font-size: 12px;
                        color: Palette.ink-muted;
                        wrap: word-wrap;
                    }
                }
                Text {
                    text: "Search runs offline over the bundled city list.";
                    font-size: 11px;
                    color: Palette.ink-muted;
                }
                Rectangle {
                    background: Palette.surface-secondary;
                    border-radius: Palette.radius-small;
                    opacity: gps_available ? 1.0 : 0.6;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;
                        Text { text: "Use my location"; font-size: 13px; font-weight: 600; color: Palette.ink; }
                        Text {
                            text: "Read once, stays on this device. Nothing leaves this device.";
                            font-size: 11px;
                            color: Palette.ink-muted;
                            wrap: word-wrap;
                        }
                    }
                    TouchArea { clicked => { if (!gps_busy) { use-gps(); } } }
                }
                if (gps_confirm_visible) : Rectangle {
                    background: Palette.surface-secondary;
                    border-color: Palette.accent;
                    border-width: 1px;
                    border-radius: Palette.radius-small;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        Text { text: "Use these coordinates?"; font-size: 14px; font-weight: 600; color: Palette.ink; }
                        Text {
                            text: "Latitude " + gps_lat + ", longitude " + gps_lon + ". This becomes your location.";
                            font-size: 12px;
                            color: Palette.ink;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Action { label: "Use"; primary: true; triggered => { gps-confirm(); } }
                            Action { label: "Cancel"; primary: false; triggered => { gps-cancel(); } }
                        }
                    }
                }
                Action {
                    label: "Enter coordinates manually";
                    primary: false;
                    triggered => { coords_open = !coords_open; }
                }
                if (coords_open) : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "Latitude"; font-size: 12px; color: Palette.ink-muted; }
                            Rectangle {
                                width: 160px;
                                height: 30px;
                                background: Palette.surface;
                                border-color: Palette.border;
                                border-width: 1px;
                                border-radius: Palette.radius-small;
                                TextInput {
                                    x: 8px; y: 5px;
                                    width: parent.width - 16px; height: 20px;
                                    text: manual_lat;
                                    font-size: 13px;
                                    color: Palette.ink;
                                    edited => { manual_lat = self.text; }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "Longitude"; font-size: 12px; color: Palette.ink-muted; }
                            Rectangle {
                                width: 160px;
                                height: 30px;
                                background: Palette.surface;
                                border-color: Palette.border;
                                border-width: 1px;
                                border-radius: Palette.radius-small;
                                TextInput {
                                    x: 8px; y: 5px;
                                    width: parent.width - 16px; height: 20px;
                                    text: manual_lon;
                                    font-size: 13px;
                                    color: Palette.ink;
                                    edited => { manual_lon = self.text; }
                                }
                            }
                        }
                    }
                    Text { text: "Timezone"; font-size: 12px; color: Palette.ink-muted; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 260px;
                            height: 30px;
                            background: Palette.surface;
                            border-color: Palette.border;
                            border-width: 1px;
                            border-radius: Palette.radius-small;
                            TextInput {
                                x: 8px; y: 5px;
                                width: parent.width - 16px; height: 20px;
                                text: manual_tz_query;
                                font-size: 13px;
                                color: Palette.ink;
                                edited => { search-tz(self.text); }
                            }
                            if (manual_tz_query == "") : Text {
                                x: 8px;
                                y: 7px;
                                text: "Search IANA timezones";
                                font-size: 13px;
                                color: Palette.ink-muted;
                            }
                        }
                        Text { text: manual_tz; font-size: 13px; color: Palette.accent; vertical-alignment: center; }
                    }
                    if (tz_results.length > 0) : Flickable {
                        height: 120px;
                        content-height: tz_results.length * 26px;
                        VerticalLayout {
                            for zone in tz_results: Rectangle {
                                height: 26px;
                                background: Palette.surface-secondary;
                                Text {
                                    text: zone.label;
                                    font-size: 12px;
                                    color: Palette.ink;
                                    vertical-alignment: center;
                                    x: 8px;
                                }
                                TouchArea { clicked => { pick-tz(zone.value); } }
                            }
                        }
                    }
                    Text { text: "Name this place (optional)"; font-size: 12px; color: Palette.ink-muted; }
                    Rectangle {
                        width: 320px;
                        height: 30px;
                        background: Palette.surface;
                        border-color: Palette.border;
                        border-width: 1px;
                        border-radius: Palette.radius-small;
                        TextInput {
                            x: 8px; y: 5px;
                            width: parent.width - 16px; height: 20px;
                            text: manual_name;
                            font-size: 13px;
                            color: Palette.ink;
                            edited => { manual_name = self.text; }
                        }
                    }
                    if (manual_error != "") : Text {
                        text: manual_error;
                        font-size: 12px;
                        color: Palette.danger;
                        wrap: word-wrap;
                    }
                    Action {
                        label: "Use these coordinates";
                        primary: true;
                        triggered => { apply-coords(manual_lat, manual_lon, manual_tz, manual_name); }
                    }
                }
                Text {
                    text: "City data: GeoNames (CC BY 4.0) · geonames.org";
                    font-size: 11px;
                    color: Palette.ink-muted;
                }
            }
        }

        // ---- athkar (Phase 4: real corpus, real progress, RTL primary) ----
        if (page == "athkar") : Flickable {
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 12px;
                    Action { label: "إغلاق"; primary: false; triggered => { close-athkar(); } }
                    Text {
                        text: athkar_label;
                        font-size: 20px;
                        font-weight: 600;
                        color: Palette.ink;
                        vertical-alignment: center;
                    }
                    Text {
                        text: athkar_progress;
                        font-size: 14px;
                        color: Palette.accent;
                        vertical-alignment: center;
                        horizontal-alignment: end;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    // Auto: follow the prayer-window context again.
                    Rectangle {
                        height: 30px;
                        width: auto-label.preferred-width + 20px;
                        border-radius: 15px;
                        background: athkar_auto ? Palette.accent : Palette.surface;
                        border-color: Palette.border;
                        border-width: 1px;
                        auto-label := Text {
                            text: "Auto";
                            font-size: 12px;
                            color: athkar_auto ? Palette.surface : Palette.ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { athkar-follow-window(); } }
                    }
                    for chip in athkar_contexts: Rectangle {
                        height: 30px;
                        width: chip-label.preferred-width + 20px;
                        border-radius: 15px;
                        background: chip.active ? Palette.accent : Palette.surface;
                        border-color: Palette.border;
                        border-width: 1px;
                        chip-label := Text {
                            text: chip.label;
                            font-size: 12px;
                            color: chip.active ? Palette.surface : Palette.ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { athkar-switch-context(chip.key); } }
                    }
                }
                Action { label: "Reset"; primary: false; triggered => { athkar-reset(); } }
                for item in athkar_items: Rectangle {
                    background: Palette.surface;
                    border-color: item.complete ? Palette.accent : Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: item.arabic;
                            font-size: 18px;
                            color: Palette.ink;
                            horizontal-alignment: end;
                            wrap: word-wrap;
                        }
                        if (item.translation != "") : Text {
                            text: item.translation;
                            font-size: 12px;
                            color: Palette.ink-muted;
                            wrap: word-wrap;
                        }
                        if (item.transliteration != "") : Text {
                            text: item.transliteration;
                            font-size: 12px;
                            color: Palette.ink-muted;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: item.reference;
                                font-size: 10px;
                                color: Palette.ink-muted;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                height: 30px;
                                width: 70px;
                                border-radius: 15px;
                                background: item.complete ? Palette.accent : Palette.surface-secondary;
                                Text {
                                    text: item.complete ? "✓" : item.counter;
                                    font-size: 12px;
                                    color: item.complete ? Palette.surface : Palette.ink;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea { clicked => { athkar-repeat(item.category, item.item-id); } }
                            }
                        }
                    }
                }
            }
        }

        // ---- credits / attribution (licence badge → here, ≤ 2 clicks) ----
        if (page == "credits") : Flickable {
            VerticalLayout {
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Credits and licences"; font-size: 20px; font-weight: 600; color: Palette.ink; }
                    Text { text: "التقديرات والتراخيص"; font-size: 20px; color: Palette.ink; }
                    Rectangle { }
                    Action { label: "إغلاق"; primary: false; triggered => { close-credits(); } }
                }
                Text { text: "Every bundled recording and file keeps its own licence, shown here as provided."; font-size: 12px; color: Palette.ink-muted; wrap: word-wrap; }
                Text { text: "كل تسجيل أو ملف مرفق يحتفظ بترخيصه الخاص، ويظهر هنا كما ورد."; font-size: 12px; color: Palette.ink-muted; horizontal-alignment: right; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 0px;
                    Text { text: "Tawadu is released under the "; font-size: 12px; color: Palette.ink; }
                    Text { text: code_license; font-size: 12px; font-weight: 600; color: Palette.ink; }
                    Text { text: " licence."; font-size: 12px; color: Palette.ink; }
                }
                // RTL reading order via reversed runs (see audio strip).
                HorizontalLayout {
                    spacing: 0px;
                    Text { text: "."; font-size: 12px; color: Palette.ink; }
                    Text { text: code_license; font-size: 12px; font-weight: 600; color: Palette.ink; }
                    Text { text: "يُصدر تطبيق تواضع وفق ترخيص "; font-size: 12px; color: Palette.ink; }
                }
                Rectangle {
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius;
                    Section { title: "Voice packs"; title-ar: "حزم الأصوات";
                        if (credit_packs.length == 0) : Text { text: "No licences to show yet."; font-size: 12px; color: Palette.ink-muted; }
                        if (credit_packs.length == 0) : Text { text: "لا توجد تراخيص لعرضها بعد."; font-size: 12px; color: Palette.ink-muted; horizontal-alignment: right; }
                        for cp in credit_packs : Rectangle {
                            background: Palette.surface-secondary;
                            border-radius: Palette.radius-small;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: cp.name; font-size: 14px; font-weight: 600; color: Palette.ink; }
                                if (cp.name-ar != "") : Text { text: cp.name-ar; font-size: 13px; color: Palette.ink-muted; horizontal-alignment: right; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    RowText { text: "Reciter"; font-size: 11px; color: Palette.ink-muted; }
                                    RowText { text: cp.reciter; font-size: 12px; color: Palette.ink; }
                                    RowText { text: "Source"; font-size: 11px; color: Palette.ink-muted; }
                                    RowText { text: cp.source; font-size: 12px; color: Palette.ink; overflow: elide; }
                                    RowText { text: "Licence"; font-size: 11px; color: Palette.ink-muted; }
                                    Badge { label: cp.license; }
                                }
                                Text { text: cp.attribution; font-size: 12px; color: Palette.ink; wrap: word-wrap; }
                                Text { text: cp.license-text; font-size: 11px; color: Palette.ink-muted; wrap: word-wrap; }
                            }
                        }
                    }
                }
                Rectangle {
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius;
                    Section { title: "Fonts"; title-ar: "الخطوط";
                        for font in credit_fonts : HorizontalLayout {
                            spacing: 8px;
                            RowText { text: font.name; font-size: 12px; color: Palette.ink; width: 180px; }
                            Badge { label: font.license; }
                            RowText { text: font.role; font-size: 11px; color: Palette.ink-muted; }
                        }
                    }
                }
                Rectangle {
                    background: Palette.surface;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: Palette.radius;
                    Section { title: "Software libraries"; title-ar: "مكتبات البرمجيات";
                        for lib in credit_libs : HorizontalLayout {
                            spacing: 8px;
                            RowText { text: lib.name; font-size: 12px; color: Palette.ink; width: 180px; }
                            Badge { label: lib.license; }
                            RowText { text: lib.role; font-size: 11px; color: Palette.ink-muted; }
                        }
                    }
                }
            }
        }
    }
}
