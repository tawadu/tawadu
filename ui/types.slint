// Shared data shapes for the interface.

export struct Row {
    name: string,
    name_ar: string,
    time: string,
    is_next: bool,
    is_prayer: bool,
}

export struct CityRow {
    name: string,
    name_ar: string,
    country: string,
}

export struct MethodRow {
    key: string,
    label: string,
    label_ar: string,
}

export struct OptionRow {
    value: string,
    label: string,
}
