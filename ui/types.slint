// Shared data shapes for the interface.

export struct Row {
    name: string,
    name_ar: string,
    time: string,
    is_next: bool,
    is_prayer: bool,
    estimated: bool,   // Phase 5: rule-produced time (muted caption)
    is_none: bool,     // Phase 5: genuinely undefined — em dash, info dot
}

// Phase 5 high-latitude rule rows (Prism §5.1, Quill §4.3 verbatim).
export struct RuleOption {
    key: string,
    label: string,
    label-ar: string,
    desc: string,
    desc-ar: string,
}

export struct CityRow {
    name: string,
    name_ar: string,
    country: string,
}

export struct MethodRow {
    key: string,
    label: string,
    label_ar: string,
}

export struct OptionRow {
    value: string,
    label: string,
}

// ---- audio (Phase 3, Prism's proposal §7) ----

export struct PackRow {
    id: string,
    name: string,
    name-ar: string,
    reciter: string,
    license: string,
    duration: string,      // "" = unknown → غير متاح, never a guess
    is-bundled: bool,
    is-selected: bool,
}

export struct VoiceOption {
    id: string,            // "" = Default, "builtin:chime", or a pack id
    label: string,
    label-ar: string,
    pack-name: string,
}

export struct EventVoiceRow {
    kind: string,          // "athan" | "iqamah" | "athkar" | "chime"
    label: string,
    label-ar: string,
    voice-id: string,      // the explicit choice ("" = Default)
    voice-label: string,   // Latin run: chosen pack name or "Default"
    voice-label-ar: string,
    mode: string,          // effective mode: "sequential" | "shuffle"
    has-override: bool,    // "Reset to pack default" only while true
    has-voice: bool,       // false = honest empty state (غير محدد)
}

export struct CreditPack {
    name: string,
    name-ar: string,
    reciter: string,
    source: string,
    license: string,
    attribution: string,
    license-text: string,  // exact licences/ file content, unedited
}

export struct CreditRow {
    name: string,
    license: string,
    role: string,
}

// ---- athkar (Phase 4: real corpus, real progress) ----

export struct AthkarItemView {
    category: int,
    item-id: int,
    arabic: string,          // primary, RTL
    translation: string,     // "" when the corpus has none — never invented
    transliteration: string, // "" when absent (sparse in the pinned corpus)
    reference: string,       // Hisn al-Muslim · category · #item
    counter: string,         // "done/target" — the honest tasbih
    done: int,
    count: int,
    complete: bool,
}

export struct ContextChip {
    key: string,
    label: string,
    active: bool,
}

// ---- Phase 5 city picker (Prism §8; region-line is Rust-composed per the
// "never compose factual strings in Slint" gotcha — admin1 code · IANA tz) ----

// Phase 5 mosque profiles (Prism §8; offsets-summary Rust-composed).
export struct MosqueProfile {
    id: string,
    name: string,
    name-ar: string,
    offsets-summary: string,
    is-active: bool,
    fajr: int,
    dhuhr: int,
    asr: int,
    maghrib: int,
    isha: int,
}

export struct CityResult {
    id: string,
    name: string,
    name-ar: string,
    country: string,
    region-line: string,
    timezone: string,
}